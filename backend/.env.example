PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/paysecure_dr
JWT_SECRET=replace_with_a_long_random_development_secret_min_32_chars
JWT_EXPIRES_IN=8h
# Real failover is ALWAYS blocked in this project. Keep false.
ALLOW_REAL_FAILOVER=false
# Simulation workload baseline (from the brief)
DAILY_TRANSACTIONS=3200000
DAILY_VALUE_INR=5000000000
SLO_AVAILABILITY=99.99
RTO_TARGET_SECONDS=300
RPO_TARGET_SECONDS=60
